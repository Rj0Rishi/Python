try:
    with open("String.txt","r",encoding="UTF-8") as point:
        lines=point.readlines()
        for i in range(min(5,len(lines))):
            print(lines[i],end="")
except FileNotFoundError:
    print("error")
except PermissionError:
    print("Error")
except Exception as e:
    print(f"Error is:{e}")                
